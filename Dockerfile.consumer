FROM bitnami/spark:3.5

USER root

RUN install_packages gcc python3-pip

WORKDIR /app

RUN curl -fsSL https://repo1.maven.org/maven2/io/delta/delta-spark_2.12/3.0.0/delta-spark_2.12-3.0.0.jar \
    -o /opt/bitnami/spark/jars/delta-spark_2.12-3.0.0.jar

RUN curl -fsSL https://repo1.maven.org/maven2/org/apache/spark/spark-sql-kafka-0-10_2.12/3.5.0/spark-sql-kafka-0-10_2.12-3.5.0.jar \
    -o /opt/bitnami/spark/jars/spark-sql-kafka-0-10_2.12-3.5.0.jar

COPY requirements.txt .
RUN pip3 install --no-cache-dir pydantic==2.5.3 kafka-python==2.0.2 requests==2.31.0 python-dotenv==1.0.0 pyyaml==6.0.1 delta-spark==3.0.0

COPY consumer/ ./consumer/
COPY producer/ ./producer/
COPY config/ ./config/

RUN mkdir -p logs

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV PYSPARK_PYTHON=python3

CMD ["python3", "-m", "consumer.spark_consumer"]
